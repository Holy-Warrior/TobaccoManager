<Window x:Class="TobaccoManager.Views.Dashboard.Components.ManageBundles"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TobaccoManager.Views.Dashboard.Components"
        mc:Ignorable="d"
        Title="Manage Bundles" Height="500" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleBlock" Text="Manage Bundles" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="BundleGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Weight (kg)" Binding="{Binding Weight}" Width="*"/>
                <DataGridTextColumn Header="Price / kg" Binding="{Binding PricePerKg}" Width="*"/>
                <DataGridTextColumn Header="Grade" Binding="{Binding LeafGrade}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice}" Width="*"/>
                <DataGridTemplateColumn Header="Actions" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Click="DeleteBundle_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Add Bundle" FontSize="16" FontWeight="Bold" Margin="0,15,0,10"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Weight (kg)" Margin="0,0,0,4"/>
                <TextBox x:Name="WeightBox"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Price / kg" Margin="0,0,0,4"/>
                <TextBox x:Name="PricePerKgBox"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                <TextBlock Text="Grade" Margin="0,0,0,4"/>
                <ComboBox x:Name="GradeComboBox"/>
            </StackPanel>

            <Button Grid.Column="3" Content="Add" VerticalAlignment="Bottom" Width="80" Click="AddBundle_Click"/>
        </Grid>
    </Grid>
</Window>
