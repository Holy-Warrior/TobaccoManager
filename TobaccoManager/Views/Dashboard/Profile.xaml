<Page x:Class="TobaccoManager.Views.Dashboard.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TobaccoManager.Views.Dashboard"
      mc:Ignorable="d"
      Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Profile">

    <StackPanel Margin="40,40,40,20" MaxWidth="480" HorizontalAlignment="Left">

        <TextBlock Text="Profile" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Account details -->
        <TextBlock Text="Account Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Name" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,10"/>

        <TextBlock Text="Email" Margin="0,0,0,4"/>
        <TextBox x:Name="EmailBox" Margin="0,0,0,10"/>

        <Button x:Name="SaveDetailsButton"
                Content="Save Changes"
                Width="160" HorizontalAlignment="Left"
                Margin="0,10,0,0"
                Click="SaveDetailsButton_Click"/>

        <Separator Margin="0,30,0,20"/>

        <!-- Password change -->
        <TextBlock Text="Change Password" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Current Password" Margin="0,0,0,4"/>
        <PasswordBox x:Name="CurrentPasswordBox" Margin="0,0,0,10"/>

        <TextBlock Text="New Password" Margin="0,0,0,4"/>
        <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,10"/>

        <TextBlock Text="Confirm New Password" Margin="0,0,0,4"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,10"/>

        <Button x:Name="ChangePasswordButton"
                Content="Change Password"
                Width="160" HorizontalAlignment="Left"
                Margin="0,10,0,0"
                Click="ChangePasswordButton_Click"/>
    </StackPanel>
</Page>
