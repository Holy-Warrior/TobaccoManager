<Page x:Class="TobaccoManager.Views.Dashboard.Calendar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TobaccoManager.Views.Dashboard"
      xmlns:conv="clr-namespace:TobaccoManager.Converters"
      mc:Ignorable="d"
      Background="White"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Calendar">

    <Page.Resources>
        <conv:DateHasEventConverter x:Key="DateHasEventConverter"/>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Top">
            <TextBlock Text="Calendar" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
            <Calendar x:Name="EventCalendar" SelectedDatesChanged="EventCalendar_SelectedDatesChanged">
                <Calendar.CalendarDayButtonStyle>
                    <Style TargetType="CalendarDayButton">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Converter={StaticResource DateHasEventConverter}}" Value="True">
                                <Setter Property="Background" Value="#ffedb8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Calendar.CalendarDayButtonStyle>
            </Calendar>
            <TextBlock Text="Highlighted days have stock or quota-agreement activity."
                       TextWrapping="Wrap" Width="240" Margin="0,10,0,0" Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="40,0,0,0">
            <TextBlock x:Name="SelectedDateHeader" Text="Select a date" FontSize="18" FontWeight="Bold" Margin="0,39,0,10"/>
            <ListBox x:Name="EventsList" MinHeight="350" BorderBrush="#ddd" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Page>
